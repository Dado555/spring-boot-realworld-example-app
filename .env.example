# Copy this file to .env and fill in real values for local development.
# Never commit a file named ".env" — only this ".env.example" template belongs in git.

# --- JWT (Step 1.5 / B13) ---
# Required. application.properties reads this with no default, so the app refuses to
# start if it is unset. Generate a fresh, random, sufficiently long secret — never reuse
# any value that has ever appeared in this repository's git history.
JWT_SECRET=changeme-generate-a-real-value

# --- Postgres datasource (spring.profiles.active=postgres) ---
# Required only when running with the "postgres" profile; the default profile uses a
# local SQLite file and does not need these.
DB_URL=jdbc:postgresql://localhost:5432/realworld
DB_USERNAME=
DB_PASSWORD=
